# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# URL of the Strapi backend API server (no trailing slash).
# When running locally, use http://localhost:1337
# For production, use your deployed backend URL (e.g. https://api.example.com)
VITE_API_URL=http://localhost:1337
